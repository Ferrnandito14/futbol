# ==========================================
# STARTUP DEPORTIVA - CONFIGURACIÓN DE ENTORNO
# ==========================================

# Base de datos (PostgreSQL con PostGIS)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/futbol_db?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# Autenticación y JWT
JWT_SECRET="super-secret-jwt-key-replace-in-production"
NEXTAUTH_SECRET="super-secret-nextauth-key-replace-in-production"
NEXTAUTH_URL="http://localhost:3000"

# Supabase (opcional para auth/storage)
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Integración Geográfica (Mapbox)
MAPBOX_API_KEY=""

# Monitoreo
SENTRY_DSN=""

# Entorno
NODE_ENV="development"
